# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Service account client_email from the downloaded JSON key.
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Service account private_key from the downloaded JSON key.
# Keep the literal \n sequences and wrap the whole value in double quotes -
# the code unescapes them to real newlines before signing the JWT.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID from the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-sheet-id

# Name of the tab to append rows to.
GOOGLE_SHEETS_SHEET_NAME=Feedback
